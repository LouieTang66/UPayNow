# UPayNow deployment environment reference. NO automatic .env loading.
# Inject values into the service process explicitly; do not commit real credentials.
# Set an absolute, persistent, access-controlled directory before first start.
# UPAY_DATA_DIR=/REPLACE_WITH_PRIVATE_PERSISTENT_DIRECTORY

# Loopback service ports
UPAY_PORT=8790
UPAY_HANDOFF_PORT=8791
UPAY_DEPLOYMENT_PORT=8792

# Replace reserved example origins with HTTPS origins you control.
# Configure DNS, certificates and reverse proxy separately; preserve Host.
# UPAY_PUBLIC_ORIGIN=https://merchant.example.com
# UPAY_HANDOFF_ORIGIN=https://collect.example.com
# UPAY_DEPLOYMENT_ORIGIN=https://deploy.example.com

# Exact comma-separated webhook hostnames; no spaces, scheme or path.
# Empty means no external callback host is allowed.
UPAY_WEBHOOK_HOSTS=

# Optional WalletConnect/Reown project ID owned by the deployer.
# Injected wallets and dedicated phone pages do not require this ID.
UPAY_WALLETCONNECT_PROJECT_ID=

# Optional official cloudflared executable path, only for on-demand quick tunnels.
# UPAY_CLOUDFLARED=/REPLACE_WITH_CLOUDFLARED_EXECUTABLE

# Configure your own chains, HTTPS RPC, payout, tokens and Factory in the UI/API.
# No wallet private key or preconfigured network belongs in this sample.
