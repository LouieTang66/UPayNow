# Example only. Adjust executable, checkout and account paths before installing.
# Build the application before starting or upgrading the service.
[Unit]
Description=UPayNow merchant service
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=upaynow
Group=upaynow
WorkingDirectory=/opt/upaynow
EnvironmentFile=-/etc/upaynow/upaynow.env
Environment=UPAY_DATA_DIR=/var/lib/upaynow
StateDirectory=upaynow
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/node /opt/upaynow/backend/server.cjs
Restart=on-failure
RestartSec=10s
KillSignal=SIGTERM
TimeoutStopSec=90s
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
